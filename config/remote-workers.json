{
  "workers": {
    "aws_tokyo_worker": {
      "enabled": false,
      "display_name": "AWS Tokyo Worker",
      "base_url": "http://AWS_WORKER_HOST:PORT",
      "auth_token_env": "AWS_WORKER_TOKEN",
      "health_check_path": "/health",
      "health_check_interval_seconds": 60,
      "capabilities": [
        "telegram",
        "overseas-web",
        "openai-api",
        "anthropic-api",
        "image-generation",
        "vless-proxy"
      ],
      "resource_limits": {
        "max_concurrent_tasks": 3,
        "timeout_seconds": 300
      }
    }
  },

  "routing_rules": [
    {
      "description": "需要访问被墙服务时，路由到 AWS worker",
      "condition": "requires_overseas_access",
      "target_worker": "aws_tokyo_worker",
      "fallback": "local"
    },
    {
      "description": "OpenAI / Anthropic API 调用走 AWS",
      "condition": "model_provider in ['openai', 'anthropic']",
      "target_worker": "aws_tokyo_worker",
      "fallback": "error"
    }
  ]
}
